{"id": "l_001", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, çok komiksin!", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_002", "emotion": "cheerful", "intensity": "strong", "text": "Gülmekten karnım ağrıdı, hahaha.", "laugh": true, "laugh_span": "hahaha"}
{"id": "l_003", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, bunu da nereden buldun?", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_004", "emotion": "cheerful", "intensity": "strong", "text": "Ay, hahaha, yüzünün hâlini görmeliydin!", "laugh": true, "laugh_span": "hahaha"}
{"id": "l_005", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, kedi yine perdeye tırmanmış.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_006", "emotion": "cheerful", "intensity": "mild", "text": "Ha ha ha, şaka yapıyorsun herhalde!", "laugh": true, "laugh_span": "Ha ha ha"}
{"id": "l_007", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, dur, nefes alamıyorum!", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_008", "emotion": "cheerful", "intensity": "mild", "text": "Hehehe, yakalandın işte.", "laugh": true, "laugh_span": "Hehehe"}
{"id": "l_009", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, babam yine aynı fıkrayı anlattı.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_010", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, o şapkayla çok tatlı olmuşsun!", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_011", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, ben de tam aynısını düşünüyordum!", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_012", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, bunu sakın annem duymasın.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_013", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, sabah terliklerimi ters giymişim.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_014", "emotion": "cheerful", "intensity": "strong", "text": "Ahaha, köpek topu kapıp kaçtı!", "laugh": true, "laugh_span": "Ahaha"}
{"id": "l_015", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, harika bir taklit, tıpkı onun gibi!", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_016", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, tamam tamam, sen kazandın.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_017", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, kahveye şeker yerine tuz atmışım.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_018", "emotion": "cheerful", "intensity": "mild", "text": "Hehe, bu sefer hesabı ben ödüyorum.", "laugh": true, "laugh_span": "Hehe"}
{"id": "l_019", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, bebek kaşığı kafasına koymuş!", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_020", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, telefonu buzdolabında bulmuşlar.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_021", "emotion": "cheerful", "intensity": "strong", "text": "Gözlerimden yaş geldi, hahaha.", "laugh": true, "laugh_span": "hahaha"}
{"id": "l_022", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, sen de mi aynı ceketi aldın?", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_023", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, öğretmen bile gülmeye başladı.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_024", "emotion": "cheerful", "intensity": "mild", "text": "Ha ha, çok iyiydi, bir daha anlat!", "laugh": true, "laugh_span": "Ha ha"}
{"id": "l_025", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, kendi sesimi kayıtta duyunca şaşırdım.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_026", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, ne biçim dans o öyle!", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_027", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, yine mi yanlış otobüse bindin?", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_028", "emotion": "cheerful", "intensity": "mild", "text": "Hehehe, sürpriz bozulmadı ama az kalsın.", "laugh": true, "laugh_span": "Hehehe"}
{"id": "l_029", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, papağan kapı zilini taklit ediyor!", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_030", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, keşke o anı kameraya çekseydik.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_031", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, kardeşim pastanın yarısını yemiş.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_032", "emotion": "cheerful", "intensity": "strong", "text": "Ahahaha, bu fotoğrafta çok komik çıkmışız!", "laugh": true, "laugh_span": "Ahahaha"}
{"id": "l_033", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, inanmıyorum, gerçekten mi?", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_034", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, adam şemsiyeyle balık tutmaya çalışıyordu.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_035", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, dedem yine gözlüğünü başında arıyor.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_036", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, kusura bakma, kendimi tutamadım.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_037", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, o ses de neydi öyle?", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_038", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, sınıfın en ciddi çocuğu bile güldü.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_039", "emotion": "cheerful", "intensity": "mild", "text": "Hehe, sen bu işi biliyorsun.", "laugh": true, "laugh_span": "Hehe"}
{"id": "l_040", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, kediyle köpek aynı sepette uyuyor!", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_041", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, çok güzel bir espriydi bu.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_042", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, bu filmi her izlediğimde gülüyorum.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_043", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, yemeği yakmışım ama yine de lezzetli.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_044", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, tam düşecekken tutundum!", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_045", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, bunu bana hiç söylememiştin.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_046", "emotion": "cheerful", "intensity": "strong", "text": "Ha ha ha, işte bu harika bir fikir!", "laugh": true, "laugh_span": "Ha ha ha"}
{"id": "l_047", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, garson siparişleri tamamen karıştırmış.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_048", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, sabahtan beri gülüyorum, duramıyorum.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_049", "emotion": "cheerful", "intensity": "strong", "text": "Hahaha, oğlum ödevini köpeğe yedirmeye çalışmış.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_050", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, tamam, artık ciddi olalım.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_051", "emotion": "cheerful", "intensity": "mild", "text": "Hahaha, telefonda sesini hiç tanıyamadım.", "laugh": true, "laugh_span": "Hahaha"}
{"id": "l_052", "emotion": "cheerful", "intensity": "strong", "text": "Hihihi, gıdıklanıyorum, yapma!", "laugh": true, "laugh_span": "Hihihi"}
